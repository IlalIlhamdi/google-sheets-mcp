# Relative paths are resolved from this project's directory, NOT the client's cwd.

# === Mode 1: Public Multi-User OAuth HTTP Server (recommended for online VPS) ===
# Set MCP_AUTH_MODE=multiuser so anyone can connect & sign in with their own Google account.
MCP_AUTH_MODE=multiuser
HTTP_HOST=127.0.0.1
HTTP_PORT=3000
MCP_TRUST_PROXY=loopback
# Public HTTPS URL ending with /mcp (e.g. via Cloudflare Tunnel)
MCP_PUBLIC_URL=https://sheets-mcp.yourdomain.com/mcp

# Google Cloud OAuth 2.0 Web Application credentials
# Redirect URI in Google Cloud Console MUST be: https://sheets-mcp.yourdomain.com/oauth/google/callback
GOOGLE_WEB_CLIENT_ID=
GOOGLE_WEB_CLIENT_SECRET=
# Or point to the downloaded Web OAuth JSON file instead of ID/Secret above:
# GOOGLE_WEB_CLIENT_FILE=.secrets/google-web-client.json

# Permissions granted to signed-in users
GOOGLE_SCOPE_MODE=readwrite
ENABLE_WRITES=true
# Allow list_spreadsheets to list each signed-in user's Google Sheets via Drive metadata readonly
GOOGLE_DRIVE_LIST=true

# Optional: leave empty in multi-user mode so users access any sheet in their own Google account
ALLOWED_SPREADSHEET_IDS=

# Persistent encrypted OAuth store & server signing key (auto-generated at .secrets/master.key if MCP_TOKEN_SECRET is unset)
MCP_OAUTH_STORE_FILE=.data/oauth-store.json
MCP_MASTER_KEY_FILE=.secrets/master.key
# MCP_TOKEN_SECRET=
MCP_REQUIRED_SCOPE=sheets:mcp
MCP_ALLOW_ANY_HTTPS_ORIGIN=true
MCP_ALLOWED_ORIGINS=

MAX_CELLS=5000
MAX_RESPONSE_BYTES=200000

# === Mode 2: Local Single-Owner Stdio / External OIDC (legacy private mode) ===
GOOGLE_CLIENT_FILE=.secrets/google-client.json
GOOGLE_TOKEN_FILE=.secrets/google-token.json
# MCP_OAUTH_ISSUER=
# MCP_JWKS_URI=
# MCP_ALLOWED_SUBJECTS=
