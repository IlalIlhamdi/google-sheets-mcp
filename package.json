{
  "name": "google-sheets-mcp-private",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Single-owner Google Sheets MCP with Google OAuth, stdio and authenticated Streamable HTTP",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "auth": "node src/cli.mjs auth",
    "verify": "node src/cli.mjs verify",
    "doctor": "node src/cli.mjs doctor",
    "revoke": "node src/cli.mjs revoke",
    "configure:public": "node scripts/configure-public.mjs",
    "start": "node src/index.mjs",
    "start:http": "node src/index.mjs --http",
    "smoke": "node scripts/smoke.mjs",
    "smoke:write": "node scripts/smoke-write.mjs",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "check": "node scripts/check.mjs"
  },
  "dependencies": {
    "@googleapis/sheets": "18.1.3",
    "@modelcontextprotocol/sdk": "1.32.2",
    "dotenv": "18.0.10",
    "express": "5.3.0",
    "google-auth-library": "11.3.4",
    "jose": "6.2.17",
    "zod": "4.6.7"
  }
}
